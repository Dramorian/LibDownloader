{
  "manifest_version": 3,
  "name": "Lib Downloader — MangaLib / SlashLib",
  "short_name": "Lib DL",
  "version": "1.6.0",
  "description": "Скачивает общедоступные главы MangaLib/SlashLib одним архивом. Интерфейс — библиотечный формуляр, без внешних ресурсов.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Скачать главы с MangaLib / SlashLib",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "scripting",
    "tabs",
    "activeTab",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://mangalib.me/*",
    "https://*.mangalib.me/*",
    "https://mangalib.org/*",
    "https://*.mangalib.org/*",
    "https://shlib.life/*",
    "https://*.shlib.life/*",
    "https://yaoilib.net/*",
    "https://*.yaoilib.net/*",
    "https://slashlib.me/*",
    "https://*.slashlib.me/*",
    "https://slashlib.org/*",
    "https://*.slashlib.org/*",
    "https://*.cdnlibs.org/*",
    "https://*.lib.social/*",
    "https://*.imglib.info/*",
    "https://*.cdnrulib.link/*",
    "https://*.hentaicdn.org/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "options_page": "app.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; font-src 'self'; style-src 'self'"
  }
}
